#!/usr/bin/env sh
set -e
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed: https://github.com/gitleaks/gitleaks#installing" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --config .gitleaks.toml 2>/dev/null \
  || gitleaks protect --staged --redact --config .gitleaks.toml
