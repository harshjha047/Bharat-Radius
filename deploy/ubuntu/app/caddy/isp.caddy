# Imported by the ACS Caddy or our edge Caddy (import /etc/caddy/sites/*.caddy). Managed by isp-platform app-up.sh.
new.bharatradius.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle /api/* {
		reverse_proxy isp-api:4100
	}
	handle /grafana* {
		reverse_proxy isp-grafana:3000
	}
	handle {
		# Content-Security-Policy comes from the web app (apps/web/src/proxy.ts): a nonce per page, no inline scripts.
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		reverse_proxy isp-web:3000
	}
}
