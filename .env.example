# Copy to .env for local dev only. Staging/production values come from secrets/<env>/app.enc.env via SOPS.
NODE_ENV=development
API_PORT=4100
MONGO_URL=mongodb://127.0.0.1:27017/isp?replicaSet=rs0
MONGO_POOL_MAX=20
RADIUS_DB_URL=postgres://app_radius:CHANGE_ME@127.0.0.1:5432/radius?sslmode=disable
RADIUS_DB_POOL_MAX=10
# Shown on the Routers page: where routers send Radius. Instance defaults from the database name in RADIUS_DB_URL;
# ports default to 1812/1813 (production) or 11812/11813 (staging).
# RADIUS_INSTANCE=production
# RADIUS_PUBLIC_HOST=203.0.113.10
RADIUS_PW_KEY=CHANGE_ME_32_byte_base64
JWT_SIGNING_KEY=CHANGE_ME_at_least_32_chars
REFRESH_TOKEN_PEPPER=CHANGE_ME_at_least_32_chars
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_byte_base64
PUBLIC_BASE_URL=http://localhost:3000
# Web landing page: call/WhatsApp buttons (empty = hidden; the demo form always shows)
# SALES_PHONE=+91 98765 43210
# Web landing page: demo-form leads are POSTed here as JSON (empty = written to the web log)
# LEAD_WEBHOOK_URL=https://hooks.slack.com/services/...
# Official product site; every install's landing page canonicalises to it
# CANONICAL_ORIGIN=https://new.bharatradius.com
# ALLOWED_ORIGINS=http://localhost:3001
# TRUST_PROXY=127.0.0.1/8
# LOGIN_MAX_FAILURES_ACCOUNT=5
# LOGIN_MAX_FAILURES_IP=20
PAY_PAGE_HTTP_HOST=127.0.0.1
COA_SOURCE_IP=0.0.0.0
TZ_BILLING=Asia/Kolkata
