# Copy to .env for local dev only. Staging/production values come from secrets/<env>/app.enc.env via SOPS.
NODE_ENV=development
API_PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/isp?replicaSet=rs0
RADIUS_DB_URL=postgres://app_radius:CHANGE_ME@127.0.0.1:5432/radius?sslmode=disable
RADIUS_DB_POOL_MAX=10
RADIUS_PW_KEY=CHANGE_ME_32_byte_base64
JWT_SIGNING_KEY=CHANGE_ME
REFRESH_TOKEN_PEPPER=CHANGE_ME
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_byte_base64
PUBLIC_BASE_URL=http://localhost:3000
PAY_PAGE_HTTP_HOST=127.0.0.1
COA_SOURCE_IP=0.0.0.0
TZ_BILLING=Asia/Kolkata
