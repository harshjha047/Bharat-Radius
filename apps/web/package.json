{
  "name": "@isp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node .next/standalone/apps/web/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "pnpm --filter @isp/api build && pnpm --filter @isp/api --silent openapi > openapi.json && openapi-typescript openapi.json -o src/lib/api-types.ts && prettier --write src/lib/api-types.ts openapi.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
